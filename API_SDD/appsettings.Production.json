{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnableHttpsRedirection": false,
  "Persistence": {
    "Provider": "MongoDB"
  },
  "ConnectionStrings": {
    "Default": "Server=DB_EXTERNA;Database=API_SDD;User Id=REEMPLAZAR_ENV;Password=REEMPLAZAR_ENV;TrustServerCertificate=True;"
  },
  "MongoDb": {
    "ConnectionString": "REEMPLAZAR_ENV_MONGODB_CONNECTION_STRING",
    "Database": "BusTrackNoSQL"
  },
  "Jwt": {
    "Key": "REEMPLAZAR_ENV_JWT_KEY_MIN_32_BYTES",
    "Issuer": "BusTrackAPI",
    "Audience": "BusTrackMobile"
  },
  "InternalService": {
    "Key": "REEMPLAZAR_ENV_INTERNAL_SERVICE_KEY"
  },
  "DataProtection": {
    "KeysPath": "/app/keys"
  },
  "PORT": "8000"
}
