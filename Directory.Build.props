<Project>
  <!-- NV-00: base homogénea para todos los proyectos ( constitution §5, AGENTS.md §1 ). -->
  <PropertyGroup>
    <AnalysisMode>All</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;CA1506;CA1515;CA1056;CA1054;CA1724;CA1308;CA1805;CA2227;S6964;CA1307</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CA1506;CA1515;CA1056;CA1054;CA1724;CA1308;CA1805;CA2227;S6964;CA1307</NoWarn>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Pins de seguridad: fuerza versiones parcheadas de transitivas (NU1902/NU1903). -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>
</Project>
