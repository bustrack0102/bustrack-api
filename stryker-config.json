{
  "stryker-config": {
    "project": "API_SDD/API_SDD.csproj",
    "test-projects": [
      "UnitTest/UnitTest.csproj"
    ],
    "solution": "API_SDD.slnx",
    "reporters": [
      "progress",
      "cleartext",
      "json"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    },
    "concurrency": 4,
    "mutate": [
      "Security/*.cs",
      "Validators/*.cs"
    ]
  }
}
